# Adresse de l API vue depuis le téléphone : l adresse IP du PC sur le Wi-Fi (ipconfig), port 3001.
# Émulateur Android : http://10.0.2.2:3001

# Fond de carte (docs/maptiler.md) : clé MapTiler du mobile. Sans clé, ou si MapTiler la refuse,
# la carte passe sur OpenStreetMap (secours).
EXPO_PUBLIC_MAPTILER_KEY=
