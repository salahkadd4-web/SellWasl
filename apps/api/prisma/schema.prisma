model InventoryCount {
  id                  String               @id @db.Uuid
  status              DocumentStatus       @default(DRAFT)
  validatedAt         DateTime?            @map("validated_at") @db.Timestamptz(3)
  companyId           String               @map("company_id") @db.Uuid
  warehouseId         String               @map("warehouse_id") @db.Uuid
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  version             Int                  @default(1)
  changeSeq           BigInt               @default(0) @map("change_seq")
  changeXid           BigInt               @default(0) @map("change_xid")
  createdByUserId     String?              @map("created_by_user_id") @db.Uuid
  createdByDeviceId   String?              @map("created_by_device_id") @db.Uuid
  occurredAt          DateTime?            @map("occurred_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouse           Warehouse            @relation(fields: [warehouseId], references: [id])
  inventoryCountLines InventoryCountLine[]

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("inventory_count")
}

/// Ligne d’inventaire. [S] [T]
model InventoryCountLine {
  id                String         @id @db.Uuid
  expectedQty       Int            @map("expected_qty")
  countedQty        Int            @map("counted_qty")
  gapQty            Int            @map("gap_qty")
  companyId         String         @map("company_id") @db.Uuid
  inventoryCountId  String         @map("inventory_count_id") @db.Uuid
  productVariantId  String         @map("product_variant_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  occurredAt        DateTime?      @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryCount    InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("inventory_count_line")
}

/// Chargement d’un camion : tournée, cash van ou rechargement (P-07). [S] [T]
model Load {
  id                String         @id @db.Uuid
  kind              LoadKind
  date              DateTime       @db.Date
  status            LoadStatus     @default(PLANNED)
  hasGap            Boolean        @default(false) @map("has_gap")
  plannedByUserId   String?        @map("planned_by_user_id") @db.Uuid
  loadedByUserId    String?        @map("loaded_by_user_id") @db.Uuid
  loadedAt          DateTime?      @map("loaded_at") @db.Timestamptz(3)
  receivedAt        DateTime?      @map("received_at") @db.Timestamptz(3)
  companyId         String         @map("company_id") @db.Uuid
  truckId           String         @map("truck_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  routeId           String?        @map("route_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  occurredAt        DateTime?      @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck             Warehouse      @relation(fields: [truckId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  route             DeliveryRoute? @relation(fields: [routeId], references: [id])
  loadLines         LoadLine[]

  @@index([companyId, truckId, date])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("load")
}

/// Ligne de chargement. [S] [T]
model LoadLine {
  id                String         @id @db.Uuid
  plannedQty        Int            @map("planned_qty")
  loadedQty         Int?           @map("loaded_qty")
  receivedQty       Int?           @map("received_qty")
  companyId         String         @map("company_id") @db.Uuid
  loadId            String         @map("load_id") @db.Uuid
  productVariantId  String         @map("product_variant_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  occurredAt        DateTime?      @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  load              Load           @relation(fields: [loadId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([loadId, productVariantId])
  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("load_line")
}

/// Déchargement du soir (BR-STK-07, P-06). [S] [T]
model Unload {
  id                String         @id @db.Uuid
  date              DateTime       @db.Date
  status            DocumentStatus @default(DRAFT)
  keepsStockInTruck Boolean        @default(false) @map("keeps_stock_in_truck")
  validatedByUserId String?        @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime?      @map("validated_at") @db.Timestamptz(3)
  companyId         String         @map("company_id") @db.Uuid
  truckId           String         @map("truck_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  workdayId         String         @unique @map("workday_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  occurredAt        DateTime?      @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  truck             Warehouse      @relation(fields: [truckId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  workday           Workday        @relation(fields: [workdayId], references: [id])
  unloadLines       UnloadLine[]

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("unload")
}

/// Ligne de déchargement. [S] [T]
model UnloadLine {
  id                String                @id @db.Uuid
  loadedQty         Int                   @map("loaded_qty")
  deliveredQty      Int                   @map("delivered_qty")
  freeQty           Int                   @map("free_qty")
  theoreticalQty    Int                   @map("theoretical_qty")
  countedQty        Int                   @map("counted_qty")
  gapQty            Int                   @map("gap_qty")
  /// Valeur d'une unité de base au moment du contrôle (prix moyen des ventes du jour), DA.
  unitValue         BigInt                @default(0) @map("unit_value")
  companyId         String                @map("company_id") @db.Uuid
  unloadId          String                @map("unload_id") @db.Uuid
  productVariantId  String                @map("product_variant_id") @db.Uuid
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(3)
  version           Int                   @default(1)
  changeSeq         BigInt                @default(0) @map("change_seq")
  changeXid         BigInt                @default(0) @map("change_xid")
  createdByUserId   String?               @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?               @map("created_by_device_id") @db.Uuid
  occurredAt        DateTime?             @map("occurred_at") @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unload            Unload                @relation(fields: [unloadId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant        @relation(fields: [productVariantId], references: [id])
  conditions        UnloadLineCondition[]
  discrepancy       Discrepancy?

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("unload_line")
}

/// Tournée : un livreur, une date (BR-PRE-01). [S]
model DeliveryRoute {
  id                String      @id @db.Uuid
  deliveryDate      DateTime    @map("delivery_date") @db.Date
  status            RouteStatus @default(DRAFT)
  launchedAt        DateTime?   @map("launched_at") @db.Timestamptz(3)
  companyId         String      @map("company_id") @db.Uuid
  deliveryUserId    String      @map("delivery_user_id") @db.Uuid
  truckId           String?     @map("truck_id") @db.Uuid
  launchedByUserId  String?     @map("launched_by_user_id") @db.Uuid
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(3)
  version           Int         @default(1)
  changeSeq         BigInt      @default(0) @map("change_seq")
  changeXid         BigInt      @default(0) @map("change_xid")
  createdByUserId   String?     @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?     @map("created_by_device_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deliveryUser      User        @relation("RouteDriver", fields: [deliveryUserId], references: [id])
  truck             Warehouse?  @relation(fields: [truckId], references: [id])
  launchedByUser    User?       @relation("RouteLauncher", fields: [launchedByUserId], references: [id])
  orders            Order[]
  loads             Load[]
  deliveries        Delivery[]

  @@unique([companyId, deliveryUserId, deliveryDate])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("delivery_route")
}

/// Tentative de livraison, ou bon de vente cash van. [S] [T]
model Delivery {
  id                     String         @id @db.Uuid
  number                 String
  attempt                Int            @default(1)
  result                 DeliveryResult
  latitude               Float?
  longitude              Float?
  deliveredAmount        BigInt         @default(0) @map("delivered_amount")
  companyId              String         @map("company_id") @db.Uuid
  orderId                String         @map("order_id") @db.Uuid
  routeId                String?        @map("route_id") @db.Uuid
  workdayId              String         @map("workday_id") @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  reasonId               String?        @map("reason_id") @db.Uuid
  refusalReasonId        String?        @map("refusal_reason_id") @db.Uuid
  contestStatus          ContestStatus  @default(NONE) @map("contest_status")
  contestComment         String?        @map("contest_comment")
  contestedAt            DateTime?      @map("contested_at") @db.Timestamptz(3)
  contestDecidedByUserId String?        @map("contest_decided_by_user_id") @db.Uuid
  contestDecidedAt       DateTime?      @map("contest_decided_at") @db.Timestamptz(3)
  deletedAt              DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version                Int            @default(1)
  changeSeq              BigInt         @default(0) @map("change_seq")
  changeXid              BigInt         @default(0) @map("change_xid")
  createdByUserId        String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId      String?        @map("created_by_device_id") @db.Uuid
  occurredAt             DateTime?      @map("occurred_at") @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  order                  Order          @relation(fields: [orderId], references: [id])
  route                  DeliveryRoute? @relation(fields: [routeId], references: [id])
  workday                Workday        @relation(fields: [workdayId], references: [id])
  user                   User           @relation(fields: [userId], references: [id])
  reason                 Reason?        @relation("DeliveryReason", fields: [reasonId], references: [id])
  refusalReason          Reason?        @relation("DeliveryRefusalReason", fields: [refusalReasonId], references: [id])
  payments               Payment[]

  @@unique([companyId, number])
  @@unique([companyId, orderId, attempt])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("delivery")
}

/// Encaissement d’une livraison ou d’une dette (BR-PAY). [S] [T]
model Payment {
  id                  String              @id @db.Uuid
  number              String
  kind                PaymentKind
  dueAmount           BigInt              @default(0) @map("due_amount")
  cashAmount          BigInt              @default(0) @map("cash_amount")
  creditAmount        BigInt              @default(0) @map("credit_amount")
  companyId           String              @map("company_id") @db.Uuid
  customerId          String              @map("customer_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  workdayId           String              @map("workday_id") @db.Uuid
  orderId             String?             @map("order_id") @db.Uuid
  deliveryId          String?             @map("delivery_id") @db.Uuid
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(3)
  version             Int                 @default(1)
  changeSeq           BigInt              @default(0) @map("change_seq")
  changeXid           BigInt              @default(0) @map("change_xid")
  createdByUserId     String?             @map("created_by_user_id") @db.Uuid
  createdByDeviceId   String?             @map("created_by_device_id") @db.Uuid
  occurredAt          DateTime?           @map("occurred_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer            Customer            @relation(fields: [customerId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  workday             Workday             @relation(fields: [workdayId], references: [id])
  order               Order?              @relation(fields: [orderId], references: [id])
  delivery            Delivery?           @relation(fields: [deliveryId], references: [id])
  customerDebtEntries CustomerDebtEntry[]

  @@unique([companyId, number])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payment")
}

/// Écriture de dette, en ajout seul (BR-PAY-04).
model CustomerDebtEntry {
  id         String        @id @db.Uuid
  kind       DebtEntryKind
  amount     BigInt
  occurredAt DateTime      @map("occurred_at") @db.Timestamptz(3)
  companyId  String        @map("company_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  paymentId  String?       @map("payment_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer   Customer      @relation(fields: [customerId], references: [id])
  payment    Payment?      @relation(fields: [paymentId], references: [id])

  @@index([companyId, customerId, occurredAt])
  @@map("customer_debt_entry")
}

/// Versement d’une journée (BR-PAY-08).
model Settlement {
  id               String       @id @db.Uuid
  expectedAmount   BigInt       @map("expected_amount")
  remittedAmount   BigInt       @map("remitted_amount")
  /// Justification du comptable (phase 21 bis).
  note             String?
  gapAmount        BigInt       @map("gap_amount")
  validatedAt      DateTime     @map("validated_at") @db.Timestamptz(3)
  isRecalculated   Boolean      @default(false) @map("is_recalculated")
  companyId        String       @map("company_id") @db.Uuid
  workdayId        String       @unique @map("workday_id") @db.Uuid
  accountantUserId String       @map("accountant_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workday          Workday      @relation(fields: [workdayId], references: [id])
  accountantUser   User         @relation(fields: [accountantUserId], references: [id])
  discrepancy      Discrepancy?

  @@index([companyId])
  @@map("settlement")
}

/// Trace d’impression ; copie 2 et plus = DUPLICATA (BR-IMP-03). [T]
model PrintLog {
  id           String            @id @db.Uuid
  documentType PrintDocumentType @map("document_type")
  documentId   String            @map("document_id") @db.Uuid
  copyNumber   Int               @map("copy_number")
  deviceId     String?           @map("device_id") @db.Uuid
  printedAt    DateTime          @map("printed_at") @db.Timestamptz(3)
  companyId    String            @map("company_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  occurredAt   DateTime?         @map("occurred_at") @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User              @relation(fields: [userId], references: [id])

  @@index([companyId, documentId])
  @@map("print_log")
}

/// Opération reçue du téléphone : idempotence et journal (BR-SYN-02, BR-SYN-07).
model SyncOperation {
  id         String     @id @db.Uuid
  opId       String     @map("op_id") @db.Uuid
  deviceSeq  Int        @map("device_seq")
  type       String
  payload    Json
  status     SyncStatus
  result     Json?
  errorCode  String?    @map("error_code")
  occurredAt DateTime   @map("occurred_at") @db.Timestamptz(3)
  receivedAt DateTime   @default(now()) @map("received_at") @db.Timestamptz(3)
  companyId  String     @map("company_id") @db.Uuid
  deviceId   String     @map("device_id") @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  device     Device     @relation(fields: [deviceId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([companyId, opId])
  @@unique([deviceId, deviceSeq])
  @@map("sync_operation")
}

/// Notification interne (BR-NOT). [S]
model Notification {
  id                String    @id @db.Uuid
  type              String
  title             String
  body              String
  data              Json?
  readAt            DateTime? @map("read_at") @db.Timestamptz(3)
  pushedAt          DateTime? @map("pushed_at") @db.Timestamptz(3)
  companyId         String    @map("company_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int       @default(1)
  changeSeq         BigInt    @default(0) @map("change_seq")
  changeXid         BigInt    @default(0) @map("change_xid")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?   @map("created_by_device_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("notification")
}

/// Audit de l’entreprise, en ajout seul (BR-AUD-01).
model AuditLog {
  id          String   @id @db.Uuid
  deviceId    String?  @map("device_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  companyId   String   @map("company_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorUser   User?    @relation(fields: [actorUserId], references: [id])

  @@index([companyId, entity, entityId])
  @@map("audit_log")
}

/// Fichier en stockage objet, rangé sous companies/<company_id>/.
model StoredFile {
  id              String      @id @db.Uuid
  kind            FileKind
  storageKey      String      @unique @map("storage_key")
  filename        String
  contentType     String      @map("content_type")
  sizeBytes       Int         @map("size_bytes")
  createdByUserId String      @map("created_by_user_id") @db.Uuid
  companyId       String      @map("company_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  importJobs      ImportJob[]

  @@index([companyId])
  @@map("stored_file")
}

/// Import CSV avec aperçu (BR-IO-01, BR-IO-02).
model ImportJob {
  id              String       @id @db.Uuid
  kind            ImportKind
  status          ImportStatus @default(PREVIEW)
  totalRows       Int          @default(0) @map("total_rows")
  importedRows    Int          @default(0) @map("imported_rows")
  errors          Json?
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  fileId          String       @map("file_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  file            StoredFile   @relation(fields: [fileId], references: [id])

  @@index([companyId])
  @@map("import_job")
}

/// Fournisseur (phase 21). [S]
model Supplier {
  id                String         @id @db.Uuid
  name              String
  phone             String?
  isActive          Boolean        @default(true) @map("is_active")
  companyId         String         @map("company_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products          Product[]
  stockReceipts     StockReceipt[]
  lots              Lot[]

  @@unique([companyId, name])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("supplier")
}

/// Lot d'un article, saisi à l'entrée en stock (phase 21). [S]
model Lot {
  id                String                @id @db.Uuid
  number            String
  expiresAt         DateTime?             @map("expires_at") @db.Date
  receivedQty       Int                   @default(0) @map("received_qty")
  companyId         String                @map("company_id") @db.Uuid
  productVariantId  String                @map("product_variant_id") @db.Uuid
  supplierId        String?               @map("supplier_id") @db.Uuid
  deletedAt         DateTime?             @map("deleted_at") @db.Timestamptz(3)
  version           Int                   @default(1)
  changeSeq         BigInt                @default(0) @map("change_seq")
  changeXid         BigInt                @default(0) @map("change_xid")
  createdByUserId   String?               @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?               @map("created_by_device_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productVariant    ProductVariant        @relation(fields: [productVariantId], references: [id])
  supplier          Supplier?             @relation(fields: [supplierId], references: [id])
  receiptLines      StockReceiptLine[]
  conditions        UnloadLineCondition[]

  @@unique([companyId, productVariantId, number])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("lot")
}

/// Répartition d'une ligne de déchargement par état constaté (phase 21). [S]
model UnloadLineCondition {
  id                String          @id @db.Uuid
  condition         ReturnCondition
  qty               Int
  /// Clé de la photo (stockage des images), obligatoire pour un produit défectueux.
  photoKey          String?         @map("photo_key")
  companyId         String          @map("company_id") @db.Uuid
  unloadLineId      String          @map("unload_line_id") @db.Uuid
  lotId             String?         @map("lot_id") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version           Int             @default(1)
  changeSeq         BigInt          @default(0) @map("change_seq")
  changeXid         BigInt          @default(0) @map("change_xid")
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?         @map("created_by_device_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  unloadLine        UnloadLine      @relation(fields: [unloadLineId], references: [id], onDelete: Cascade)
  lot               Lot?            @relation(fields: [lotId], references: [id])

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("unload_line_condition")
}

/// Fait figé de l'analyse des retours, écrit par la livraison et le déchargement (phase 21).
/// Les axes sont des identifiants sans clé étrangère : ils gardent la valeur du moment.
model ReturnFact {
  id               String           @id @db.Uuid
  kind             ReturnFactKind
  date             DateTime         @db.Date
  /// Unité de base ; écart (GAP) signé.
  qty              Int
  value            BigInt           @default(0)
  condition        ReturnCondition?
  companyId        String           @map("company_id") @db.Uuid
  productVariantId String           @map("product_variant_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  lotId            String?          @map("lot_id") @db.Uuid
  supplierId       String?          @map("supplier_id") @db.Uuid
  sellerUserId     String?          @map("seller_user_id") @db.Uuid
  driverUserId     String?          @map("driver_user_id") @db.Uuid
  customerId       String?          @map("customer_id") @db.Uuid
  territoryId      String?          @map("territory_id") @db.Uuid
  partId           String?          @map("part_id") @db.Uuid
  routeId          String?          @map("route_id") @db.Uuid
  orderId          String?          @map("order_id") @db.Uuid
  deliveryId       String?          @map("delivery_id") @db.Uuid
  unloadId         String?          @map("unload_id") @db.Uuid
  reasonId         String?          @map("reason_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companyId, kind, date])
  @@index([companyId, deliveryId])
  @@map("return_fact")
}

/// Écart de stock (déchargement) ou de caisse (versement), jusqu'à la décision du comptable (phase 21 bis).
enum DiscrepancyKind {
  STOCK
  FINANCIAL
}

enum DiscrepancyStatus {
  VALIDATED
  UNDER_REVIEW
  REJECTED
  RESOLVED
  DEDUCTION_PENDING
  DEDUCTION_APPROVED
  DEDUCTION_APPLIED
}

enum AdvanceStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  DEDUCTED
}

enum DeductionSource {
  STOCK_DISCREPANCY
  FINANCIAL_DISCREPANCY
  OTHER
}

enum DeductionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum IncentiveKind {
  PER_UNIT
  PERCENT_REVENUE
  THRESHOLD
  TIERED
  REVENUE_TARGET
}

enum IncentiveFrequency {
  WEEKLY
  MONTHLY
}

enum IncentiveStatus {
  CALCULATED
  VALIDATED
  REJECTED
  APPLIED
}

enum PayrollStatus {
  OPEN
  CALCULATED
  APPROVED
  PAID
  CLOSED
}

enum PayrollLineKind {
  BASE_SALARY
  INCENTIVE
  OBJECTIVE_BONUS
  DRIVER_BONUS
  ADJUSTMENT
  ADVANCE
  DEDUCTION
}

/// Écart constaté, validé par qui l'a constaté (magasinier ou comptable). [S]
model Discrepancy {
  id                String            @id @db.Uuid
  kind              DiscrepancyKind
  status            DiscrepancyStatus @default(VALIDATED)
  date              DateTime          @db.Date
  /// Unité de base, signée (négatif : manque).
  qty               Int?
  unitValue         BigInt?           @map("unit_value")
  /// DA, signé (négatif : manque).
  amount            BigInt
  cause             String?
  decisionNote      String?           @map("decision_note")
  validatedByUserId String            @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime          @map("validated_at") @db.Timestamptz(3)
  decidedByUserId   String?           @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(3)
  companyId         String            @map("company_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  workdayId         String            @map("workday_id") @db.Uuid
  productVariantId  String?           @map("product_variant_id") @db.Uuid
  unloadLineId      String?           @unique @map("unload_line_id") @db.Uuid
  settlementId      String?           @unique @map("settlement_id") @db.Uuid
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  version           Int               @default(1)
  changeSeq         BigInt            @default(0) @map("change_seq")
  changeXid         BigInt            @default(0) @map("change_xid")
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user              User              @relation(fields: [userId], references: [id])
  unloadLine        UnloadLine?       @relation(fields: [unloadLineId], references: [id])
  settlement        Settlement?       @relation(fields: [settlementId], references: [id])
  deduction         PayrollDeduction?

  @@index([companyId, status])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("discrepancy")
}

/// Rémunération d'un employé, avec son historique (phase 21 bis). [S]
model EmployeeCompensation {
  id              String    @id @db.Uuid
  /// DA par mois.
  baseSalary      BigInt    @map("base_salary")
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  note            String?
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)
  changeSeq       BigInt    @default(0) @map("change_seq")
  changeXid       BigInt    @default(0) @map("change_xid")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User      @relation(fields: [userId], references: [id])

  @@unique([companyId, userId, effectiveFrom])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("employee_compensation")
}

/// Acompte sur salaire, déduit de la paie du mois (phase 21 bis). [S]
model SalaryAdvance {
  id              String        @id @db.Uuid
  month           DateTime      @db.Date
  amount          BigInt
  reason          String?
  status          AdvanceStatus @default(REQUESTED)
  requestedAt     DateTime      @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedByUserId String?       @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(3)
  paidByUserId    String?       @map("paid_by_user_id") @db.Uuid
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz(3)
  deductedAt      DateTime?     @map("deducted_at") @db.Timestamptz(3)
  payrollPeriodId String?       @map("payroll_period_id") @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)
  version         Int           @default(1)
  changeSeq       BigInt        @default(0) @map("change_seq")
  changeXid       BigInt        @default(0) @map("change_xid")
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id])

  @@index([companyId, month])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("salary_advance")
}

/// Retenue sur rémunération, jamais appliquée sans approbation (phase 21 bis). [S]
model PayrollDeduction {
  id               String          @id @db.Uuid
  amount           BigInt
  reason           String
  sourceType       DeductionSource @map("source_type")
  /// Mois de paie visé ; null : la prochaine paie calculée.
  month            DateTime?       @db.Date
  status           DeductionStatus @default(PENDING)
  approvedByUserId String?         @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime?       @map("approved_at") @db.Timestamptz(3)
  appliedAt        DateTime?       @map("applied_at") @db.Timestamptz(3)
  payrollPeriodId  String?         @map("payroll_period_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  discrepancyId    String?         @unique @map("discrepancy_id") @db.Uuid
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version          Int             @default(1)
  changeSeq        BigInt          @default(0) @map("change_seq")
  changeXid        BigInt          @default(0) @map("change_xid")
  createdByUserId  String?         @map("created_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user             User            @relation(fields: [userId], references: [id])
  discrepancy      Discrepancy?    @relation(fields: [discrepancyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_deduction")
}

/// Règle de prime : par unité, pourcentage, seuil, paliers ou objectif de CA (phase 21 bis). [S]
model IncentiveRule {
  id              String             @id @db.Uuid
  name            String
  kind            IncentiveKind
  frequency       IncentiveFrequency
  amount          BigInt?
  percentBp       Int?               @map("percent_bp")
  threshold       BigInt?
  tiers           Json?
  roleCode        RoleCode?          @map("role_code")
  isActive        Boolean            @default(true) @map("is_active")
  validFrom       DateTime           @map("valid_from") @db.Date
  validTo         DateTime?          @map("valid_to") @db.Date
  unitId          String?            @map("unit_id") @db.Uuid
  companyId       String             @map("company_id") @db.Uuid
  productId       String?            @map("product_id") @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)
  version         Int                @default(1)
  changeSeq       BigInt             @default(0) @map("change_seq")
  changeXid       BigInt             @default(0) @map("change_xid")
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product         Product?           @relation(fields: [productId], references: [id])
  user            User?              @relation(fields: [userId], references: [id])
  incentives      Incentive[]

  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("incentive_rule")
}

/// Prime calculée d'un employé pour une période ; une seule par règle, employé et période. [S]
model Incentive {
  id                String          @id @db.Uuid
  periodStart       DateTime        @map("period_start") @db.Date
  periodEnd         DateTime        @map("period_end") @db.Date
  quantity          Int
  revenue           BigInt          @default(0)
  unitAmount        BigInt?         @map("unit_amount")
  amount            BigInt
  /// Ventes comptées : commande, livraison, quantité, montant.
  details           Json            @default("[]")
  status            IncentiveStatus @default(CALCULATED)
  validatedByUserId String?         @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime?       @map("validated_at") @db.Timestamptz(3)
  appliedAt         DateTime?       @map("applied_at") @db.Timestamptz(3)
  payrollPeriodId   String?         @map("payroll_period_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  ruleId            String          @map("rule_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version           Int             @default(1)
  changeSeq         BigInt          @default(0) @map("change_seq")
  changeXid         BigInt          @default(0) @map("change_xid")
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rule              IncentiveRule   @relation(fields: [ruleId], references: [id])
  user              User            @relation(fields: [userId], references: [id])

  @@unique([ruleId, userId, periodStart])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("incentive")
}

/// Paie d'un mois (phase 21 bis). [S]
model PayrollPeriod {
  id                 String         @id @db.Uuid
  month              DateTime       @db.Date
  status             PayrollStatus  @default(OPEN)
  calculatedAt       DateTime?      @map("calculated_at") @db.Timestamptz(3)
  calculatedByUserId String?        @map("calculated_by_user_id") @db.Uuid
  approvedAt         DateTime?      @map("approved_at") @db.Timestamptz(3)
  approvedByUserId   String?        @map("approved_by_user_id") @db.Uuid
  paidAt             DateTime?      @map("paid_at") @db.Timestamptz(3)
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz(3)
  closedByUserId     String?        @map("closed_by_user_id") @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  deletedAt          DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version            Int            @default(1)
  changeSeq          BigInt         @default(0) @map("change_seq")
  changeXid          BigInt         @default(0) @map("change_xid")
  createdByUserId    String?        @map("created_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries            PayrollEntry[]

  @@unique([companyId, month])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_period")
}

/// Fiche de paie d'un employé pour un mois. [S]
model PayrollEntry {
  id              String           @id @db.Uuid
  baseSalary      BigInt           @map("base_salary")
  earnings        BigInt           @default(0)
  advances        BigInt           @default(0)
  deductions      BigInt           @default(0)
  net             BigInt
  companyId       String           @map("company_id") @db.Uuid
  periodId        String           @map("period_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)
  version         Int              @default(1)
  changeSeq       BigInt           @default(0) @map("change_seq")
  changeXid       BigInt           @default(0) @map("change_xid")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  period          PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id])
  lines           PayrollLine[]
  payments        PayrollPayment[]

  @@unique([periodId, userId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_entry")
}

/// Ligne d'une fiche de paie, avec sa source (rémunération, prime, acompte, retenue…). [S]
model PayrollLine {
  id              String          @id @db.Uuid
  kind            PayrollLineKind
  label           String
  /// DA, signé.
  amount          BigInt
  sourceType      String?         @map("source_type")
  sourceId        String?         @map("source_id") @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  entryId         String          @map("entry_id") @db.Uuid
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version         Int             @default(1)
  changeSeq       BigInt          @default(0) @map("change_seq")
  changeXid       BigInt          @default(0) @map("change_xid")
  createdByUserId String?         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry           PayrollEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_line")
}

/// Échéance de paiement d'une fiche, payée une seule fois. [S]
model PayrollPayment {
  id              String       @id @db.Uuid
  installment     Int
  dueDate         DateTime     @map("due_date") @db.Date
  percent         Int
  amount          BigInt
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(3)
  paidByUserId    String?      @map("paid_by_user_id") @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  entryId         String       @map("entry_id") @db.Uuid
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  version         Int          @default(1)
  changeSeq       BigInt       @default(0) @map("change_seq")
  changeXid       BigInt       @default(0) @map("change_xid")
  createdByUserId String?      @map("created_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entry           PayrollEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, installment])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_payment")
}

/// Correction contrôlée d'une paie : prise dans la paie du mois tant qu'elle n'est pas approuvée. [S]
model PayrollAdjustment {
  id              String    @id @db.Uuid
  month           DateTime  @db.Date
  /// DA, signé.
  amount          BigInt
  reason          String
  payrollPeriodId String?   @map("payroll_period_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)
  changeSeq       BigInt    @default(0) @map("change_seq")
  changeXid       BigInt    @default(0) @map("change_xid")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User      @relation(fields: [userId], references: [id])

  @@index([companyId, month])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("payroll_adjustment")
}
