// Schéma PostgreSQL de SellWasl — voir docs/database.md.
// Généré à partir de la spécification de la phase 3, puis maintenu à la main.
//
// Conventions (docs/database.md §1) :
// - id UUID v7 généré par l'application ; tables et colonnes en snake_case ;
// - montants en dinars entiers (BigInt), quantités en unité de base (Int) ;
// - tables S (synchronisées) : deleted_at, version, change_seq, created_by_user_id,
//   created_by_device_id. change_seq et version sont tenus par un trigger PostgreSQL
//   (migration « sync_triggers ») ;
// - tables T (créées par le téléphone) : occurred_at en plus.
//
// Contraintes CHECK, triggers et droits de l'audit : voir les migrations SQL.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum SalesMode {
  PRE_SALES
  CASH_VAN
  MIXED
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ModuleCode {
  PRE_SALES
  DELIVERY
  CASH_VAN
  WAREHOUSE
  ANALYTICS
  RETURNS_ANALYSIS
}

enum ModuleStatus {
  ACTIVE
  INACTIVE
}

enum RoleCode {
  COMPANY_ADMIN
  SUPERVISEUR
  COMPTABLE
  PRE_VENDEUR
  VENDEUR_CASH_VAN
  LIVREUR
  MAGASINIER
}

enum Channel {
  WEB
  MOBILE
}

enum PermissionScope {
  PLATFORM
  COMPANY
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  BLOCKED
}

enum ReasonKind {
  NO_ORDER
  DELIVERY_FAILURE
  ADJUSTMENT
  FORCED_CLOSE
  REOPEN
  REFUSAL
}

enum ReasonSystemCode {
  CUSTOMER_ABSENT
  STORE_CLOSED
  CLOSED_PERMANENTLY
  REFUSED
  NOT_DELIVERED
  OTHER
}

enum WarehouseType {
  DEPOT
  TRUCK
}

enum ThresholdScope {
  ALL_VARIANTS
  PER_VARIANT
}

enum FreeVariantMode {
  FIXED
  SELLER_CHOICE
  AUTO_MOST_STOCK
}

enum Weekday {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

enum VisitFrequency {
  WEEKLY
  BIWEEKLY
  EVERY_4_WEEKS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum LostDemandKind {
  LOST_SALE
  LOST_DEMAND
}

enum WorkdayStatus {
  NOT_STARTED
  IN_PROGRESS
  CLOSED
}

enum VisitMode {
  ON_SITE
  PHONE
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum VisitOutcome {
  ORDER
  SALE
  NO_ORDER
}

enum OrderSource {
  PRE_SALES
  PHONE
  CASH_VAN
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  LOCKED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  FAILED
  CANCELLED
}

enum OrderLineKind {
  NORMAL
  PENDING
  BONUS
}

enum PendingStatus {
  TO_PROCESS
  ACCEPTED
  REFUSED
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  RESERVATION
  RELEASE
  ADJUSTMENT
  WRITE_OFF
}

/// État constaté au déchargement (phase 21).
enum ReturnCondition {
  RESTOCK
  DEFECTIVE
  EXPIRED
  BROKEN
}

/// Fait de l'analyse des retours (phase 21).
enum ReturnFactKind {
  REFUSAL
  RESALE
  RETURN
  GAP
}

/// Contestation d'un refus par le pré-vendeur (phase 21).
enum ContestStatus {
  NONE
  CONTESTED
  UPHELD
  REJECTED
}

enum StockSourceType {
  ORDER
  DELIVERY
  LOAD
  UNLOAD
  RECEIPT
  INVENTORY
}

enum DocumentStatus {
  DRAFT
  VALIDATED
}

enum LoadKind {
  ROUTE
  CASH_VAN
  RELOAD
}

enum LoadStatus {
  PLANNED
  LOADED
  RECEIVED
}

enum RouteStatus {
  DRAFT
  PREPARING
  READY
  LOADED
  OUT_FOR_DELIVERY
  CLOSED
}

enum DeliveryResult {
  DELIVERED
  PARTIAL
  FAILED
}

enum PaymentKind {
  DELIVERY_PAYMENT
  DEBT_PAYMENT
}

enum DebtEntryKind {
  CREDIT_SALE
  DEBT_PAYMENT
  ADVANCE
  ADVANCE_USED
}

enum PrintDocumentType {
  DELIVERY_NOTE
  SALE_NOTE
  DEBT_RECEIPT
  DAY_SUMMARY
}

enum SyncStatus {
  APPLIED
  APPLIED_WITH_CHANGES
  REJECTED
}

enum FileKind {
  IMPORT
  EXPORT
  LOGO
}

enum ImportKind {
  CUSTOMERS
  PRODUCTS
}

enum ImportStatus {
  PREVIEW
  IMPORTED
  FAILED
}

/// Entreprise cliente (tenant).
model Company {
  id                      String                 @id @db.Uuid
  name                    String
  code                    String                 @unique
  mode                    SalesMode
  status                  CompanyStatus          @default(TRIAL)
  timezone                String                 @default("Africa/Algiers")
  createdByPlatformUserId String?                @map("created_by_platform_user_id") @db.Uuid
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  companyModules          CompanyModule[]
  companySettingses       CompanySettings[]
  roles                   Role[]
  users                   User[]
  sessions                Session[]
  devices                 Device[]
  deviceActivationCodes   DeviceActivationCode[]
  devicePings             DevicePing[]
  customerTypes           CustomerType[]
  holidays                Holiday[]
  reasons                 Reason[]
  warehouses              Warehouse[]
  productRanges           ProductRange[]
  productCategories       ProductCategory[]
  products                Product[]
  productVariants         ProductVariant[]
  productUnits            ProductUnit[]
  prices                  Price[]
  priceTiers              PriceTier[]
  bonusRules              BonusRule[]
  territories             Territory[]
  territoryParts          TerritoryPart[]
  partSchedules           PartSchedule[]
  customers               Customer[]
  customerReschedules     CustomerReschedule[]
  quotas                  Quota[]
  objectives              Objective[]
  driverObjectives        DriverObjective[]
  lostDemands             LostDemand[]
  workdays                Workday[]
  visits                  Visit[]
  orders                  Order[]
  orderLines              OrderLine[]
  stocks                  Stock[]
  stockMovements          StockMovement[]
  stockReceipts           StockReceipt[]
  stockReceiptLines       StockReceiptLine[]
  inventoryCounts         InventoryCount[]
  inventoryCountLines     InventoryCountLine[]
  loads                   Load[]
  loadLines               LoadLine[]
  unloads                 Unload[]
  unloadLines             UnloadLine[]
  deliveryRoutes          DeliveryRoute[]
  deliveries              Delivery[]
  payments                Payment[]
  customerDebtEntries     CustomerDebtEntry[]
  settlements             Settlement[]
  printLogs               PrintLog[]
  syncOperations          SyncOperation[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  storedFiles             StoredFile[]
  importJobs              ImportJob[]
  suppliers               Supplier[]
  lots                    Lot[]
  unloadLineConditions    UnloadLineCondition[]
  returnFacts             ReturnFact[]
  discrepancies           Discrepancy[]
  employeeCompensations   EmployeeCompensation[]
  salaryAdvances          SalaryAdvance[]
  payrollDeductions       PayrollDeduction[]
  incentiveRules          IncentiveRule[]
  incentives              Incentive[]
  payrollPeriods          PayrollPeriod[]
  payrollEntries          PayrollEntry[]
  payrollLines            PayrollLine[]
  payrollPayments         PayrollPayment[]
  payrollAdjustments      PayrollAdjustment[]

  @@map("company")
}

/// Compte Super Admin, séparé des utilisateurs d’entreprise.
model PlatformUser {
  id               String            @id @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  name             String
  role             PlatformRole      @default(SUPER_ADMIN)
  status           AccountStatus     @default(ACTIVE)
  lastLoginAt      DateTime?         @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  platformSessions PlatformSession[]

  @@map("platform_user")
}

/// Session du Super Admin.
model PlatformSession {
  id               String       @id @db.Uuid
  refreshTokenHash String       @unique @map("refresh_token_hash")
  familyId         String       @map("family_id") @db.Uuid
  expiresAt        DateTime     @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime?    @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?    @map("revoked_at") @db.Timestamptz(3)
  ip               String?
  userAgent        String?      @map("user_agent")
  platformUserId   String       @map("platform_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  platformUser     PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  @@map("platform_session")
}

/// Audit plateforme, en ajout seul.
model PlatformAuditLog {
  id             String   @id @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id") @db.Uuid
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([companyId, createdAt])
  @@map("platform_audit_log")
}

/// Modules actifs, déduits du mode (BR-TEN-03).
model CompanyModule {
  id            String       @id @db.Uuid
  moduleCode    ModuleCode   @map("module_code")
  status        ModuleStatus @default(ACTIVE)
  activatedAt   DateTime?    @map("activated_at") @db.Timestamptz(3)
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  config        Json?
  companyId     String       @map("company_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, moduleCode])
  @@map("company_module")
}

/// Paramètres versionnés ; une ligne n’est jamais modifiée (ARC-12).
model CompanySettings {
  id              String   @id @db.Uuid
  version         Int
  data            Json
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, version])
  @@map("company_settings")
}

/// Rôle d’entreprise (BR-USR-01).
model Role {
  id              String           @id @db.Uuid
  code            RoleCode
  name            String
  channel         Channel
  isSystem        Boolean          @default(true) @map("is_system")
  companyId       String           @map("company_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  users           User[]

  @@unique([companyId, code])
  @@map("role")
}

/// Catalogue global des permissions (docs/rbac.md §4).
model Permission {
  code            String           @id
  description     String
  scope           PermissionScope
  rolePermissions RolePermission[]

  @@map("permission")
}

/// Permissions d’un rôle.
model RolePermission {
  roleId         String     @map("role_id") @db.Uuid
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permission")
}

/// Utilisateur d’entreprise : un seul rôle. [S]
model User {
  id                             String                 @id @db.Uuid
  code                           String
  firstName                      String                 @map("first_name")
  lastName                       String                 @map("last_name")
  phone                          String?
  email                          String?
  passwordHash                   String                 @map("password_hash")
  status                         AccountStatus          @default(ACTIVE)
  mustChangePassword             Boolean                @default(true) @map("must_change_password")
  lastLoginAt                    DateTime?              @map("last_login_at") @db.Timestamptz(3)
  companyId                      String                 @map("company_id") @db.Uuid
  roleId                         String                 @map("role_id") @db.Uuid
  deletedAt                      DateTime?              @map("deleted_at") @db.Timestamptz(3)
  version                        Int                    @default(1)
  changeSeq                      BigInt                 @default(0) @map("change_seq")
  changeXid                      BigInt                 @default(0) @map("change_xid")
  createdByUserId                String?                @map("created_by_user_id") @db.Uuid
  createdByDeviceId              String?                @map("created_by_device_id") @db.Uuid
  createdAt                      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                        Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role                           Role                   @relation(fields: [roleId], references: [id])
  sessions                       Session[]
  devices                        Device[]
  deviceActivationCodes          DeviceActivationCode[]
  devicePings                    DevicePing[]
  warehouses                     Warehouse[]
  territoriesAsSellerUser        Territory[]            @relation("TerritorySeller")
  territoriesAsDeliveryUser      Territory[]            @relation("TerritoryDelivery")
  quotas                         Quota[]
  objectives                     Objective[]
  driverObjectives               DriverObjective[]
  lostDemands                    LostDemand[]
  workdays                       Workday[]
  visits                         Visit[]
  orders                         Order[]
  stockMovements                 StockMovement[]
  loads                          Load[]
  unloads                        Unload[]
  deliveryRoutesAsDeliveryUser   DeliveryRoute[]        @relation("RouteDriver")
  deliveryRoutesAsLaunchedByUser DeliveryRoute[]        @relation("RouteLauncher")
  discrepancies                  Discrepancy[]
  employeeCompensations          EmployeeCompensation[]
  salaryAdvances                 SalaryAdvance[]
  payrollDeductions              PayrollDeduction[]
  incentiveRules                 IncentiveRule[]
  incentives                     Incentive[]
  payrollEntries                 PayrollEntry[]
  payrollAdjustments             PayrollAdjustment[]
  deliveries                     Delivery[]
  payments                       Payment[]
  settlements                    Settlement[]
  printLogs                      PrintLog[]
  syncOperations                 SyncOperation[]
  notifications                  Notification[]
  auditLogs                      AuditLog[]

  @@unique([companyId, code])
  @@unique([companyId, email])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("user")
}

/// Session Web ou mobile ; jeton de rafraîchissement à rotation.
model Session {
  id               String    @id @db.Uuid
  channel          Channel
  refreshTokenHash String    @unique @map("refresh_token_hash")
  familyId         String    @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")
  ip               String?
  userAgent        String?   @map("user_agent")
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  deviceId         String?   @map("device_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           Device?   @relation(fields: [deviceId], references: [id])

  @@index([companyId, userId])
  @@map("session")
}

/// Téléphone associé à un utilisateur terrain (BR-USR-06, ARC-11).
model Device {
  id                    String                 @id @db.Uuid
  series                String
  status                DeviceStatus           @default(ACTIVE)
  name                  String?
  model                 String?
  osVersion             String?                @map("os_version")
  appVersion            String?                @map("app_version")
  pushToken             String?                @map("push_token")
  activatedAt           DateTime               @map("activated_at") @db.Timestamptz(3)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt            DateTime?              @map("last_seen_at") @db.Timestamptz(3)
  lastSyncAt            DateTime?              @map("last_sync_at") @db.Timestamptz(3)
  batteryLevel          Int?                   @map("battery_level")
  pendingOps            Int                    @default(0) @map("pending_ops")
  lastDeviceSeq         Int                    @default(0) @map("last_device_seq")
  lastLatitude          Float?                 @map("last_latitude")
  lastLongitude         Float?                 @map("last_longitude")
  lastPositionAt        DateTime?              @map("last_position_at") @db.Timestamptz(3)
  companyId             String                 @map("company_id") @db.Uuid
  userId                String                 @map("user_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id])
  sessions              Session[]
  deviceActivationCodes DeviceActivationCode[]
  devicePings           DevicePing[]
  workdays              Workday[]
  syncOperations        SyncOperation[]

  @@unique([companyId, userId, series])
  @@unique([companyId, userId], map: "device_one_active_per_user", where: raw("status = 'ACTIVE'"))
  @@map("device")
}

/// Code d’association à usage unique, 10 minutes (ARC-04).
model DeviceActivationCode {
  id              String    @id @db.Uuid
  codeHash        String    @unique @map("code_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  usedByDeviceId  String?   @map("used_by_device_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedByDevice    Device?   @relation(fields: [usedByDeviceId], references: [id])

  @@index([companyId])
  @@map("device_activation_code")
}

/// Signal de vie pendant la journée ; conservé 90 jours (BR-JOU-09).
model DevicePing {
  id           String   @id @db.Uuid
  latitude     Float?
  longitude    Float?
  accuracyM    Float?   @map("accuracy_m")
  batteryLevel Int?     @map("battery_level")
  pendingOps   Int      @default(0) @map("pending_ops")
  recordedAt   DateTime @map("recorded_at") @db.Timestamptz(3)
  companyId    String   @map("company_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  deviceId     String   @map("device_id") @db.Uuid
  workdayId    String?  @map("workday_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user         User     @relation(fields: [userId], references: [id])
  device       Device   @relation(fields: [deviceId], references: [id])
  workday      Workday? @relation(fields: [workdayId], references: [id])

  @@index([companyId, userId, recordedAt])
  @@map("device_ping")
}

/// Type de client (BR-CAT-03). [S]
model CustomerType {
  id                     String                  @id @db.Uuid
  code                   String
  name                   String
  isActive               Boolean                 @default(true) @map("is_active")
  companyId              String                  @map("company_id") @db.Uuid
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  version                Int                     @default(1)
  changeSeq              BigInt                  @default(0) @map("change_seq")
  changeXid              BigInt                  @default(0) @map("change_xid")
  createdByUserId        String?                 @map("created_by_user_id") @db.Uuid
  createdByDeviceId      String?                 @map("created_by_device_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  prices                 Price[]
  priceTiers             PriceTier[]
  bonusRuleCustomerTypes BonusRuleCustomerType[]
  territoryCustomerTypes TerritoryCustomerType[]
  customers              Customer[]
  orders                 Order[]

  @@unique([companyId, code])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("customer_type")
}

/// Jour férié (BR-TEN-06). [S]
model Holiday {
  id                String    @id @db.Uuid
  date              DateTime  @db.Date
  label             String
  companyId         String    @map("company_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int       @default(1)
  changeSeq         BigInt    @default(0) @map("change_seq")
  changeXid         BigInt    @default(0) @map("change_xid")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?   @map("created_by_device_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, date])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("holiday")
}

/// Motif réglable ; system_code déclenche un comportement (docs/database.md §5). [S]
model Reason {
  id                String            @id @db.Uuid
  kind              ReasonKind
  systemCode        ReasonSystemCode? @map("system_code")
  label             String
  isActive          Boolean           @default(true) @map("is_active")
  sortOrder         Int               @default(0) @map("sort_order")
  companyId         String            @map("company_id") @db.Uuid
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(3)
  version           Int               @default(1)
  changeSeq         BigInt            @default(0) @map("change_seq")
  changeXid         BigInt            @default(0) @map("change_xid")
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?           @map("created_by_device_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workdays          Workday[]
  visits            Visit[]
  stockMovements    StockMovement[]
  deliveries        Delivery[]        @relation("DeliveryReason")
  refusedDeliveries Delivery[]        @relation("DeliveryRefusalReason")

  @@unique([companyId, kind, label])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("reason")
}

/// Dépôt ou camion (BR-STK-01). [S]
model Warehouse {
  id                            String           @id @db.Uuid
  type                          WarehouseType
  code                          String
  name                          String
  plateNumber                   String?          @map("plate_number")
  isActive                      Boolean          @default(true) @map("is_active")
  companyId                     String           @map("company_id") @db.Uuid
  assignedUserId                String?          @map("assigned_user_id") @db.Uuid
  deletedAt                     DateTime?        @map("deleted_at") @db.Timestamptz(3)
  version                       Int              @default(1)
  changeSeq                     BigInt           @default(0) @map("change_seq")
  changeXid                     BigInt           @default(0) @map("change_xid")
  createdByUserId               String?          @map("created_by_user_id") @db.Uuid
  createdByDeviceId             String?          @map("created_by_device_id") @db.Uuid
  createdAt                     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignedUser                  User?            @relation(fields: [assignedUserId], references: [id])
  stocks                        Stock[]
  stockMovementsAsFromWarehouse StockMovement[]  @relation("MovementFrom")
  stockMovementsAsToWarehouse   StockMovement[]  @relation("MovementTo")
  stockReceipts                 StockReceipt[]
  inventoryCounts               InventoryCount[]
  loads                         Load[]
  unloads                       Unload[]
  deliveryRoutes                DeliveryRoute[]

  @@unique([companyId, code])
  @@unique([companyId, assignedUserId], map: "warehouse_one_truck_per_user", where: raw("type = 'TRUCK' AND assigned_user_id IS NOT NULL"))
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("warehouse")
}

/// Objectif mensuel d'un livreur : prime et notes des critères (phase 19). [S]
model DriverObjective {
  id              String    @id @db.Uuid
  month           DateTime  @db.Date
  bonusAmount     BigInt    @default(0) @map("bonus_amount")
  /// Notes sur 10 par critère : { criterionId: note }
  ratings         Json      @default("{}")
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  version         Int       @default(1)
  changeSeq       BigInt    @default(0) @map("change_seq")
  changeXid       BigInt    @default(0) @map("change_xid")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user            User      @relation(fields: [userId], references: [id])

  @@unique([companyId, userId, month])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("driver_objective")
}

/// Gamme (BR-CAT-01). [S]
model ProductRange {
  id                String      @id @db.Uuid
  code              String
  name              String
  isActive          Boolean     @default(true) @map("is_active")
  companyId         String      @map("company_id") @db.Uuid
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(3)
  version           Int         @default(1)
  changeSeq         BigInt      @default(0) @map("change_seq")
  changeXid         BigInt      @default(0) @map("change_xid")
  createdByUserId   String?     @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?     @map("created_by_device_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products          Product[]
  objectives        Objective[]

  @@unique([companyId, code])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("product_range")
}

/// Catégorie de produits. [S]
model ProductCategory {
  id                String    @id @db.Uuid
  name              String
  isActive          Boolean   @default(true) @map("is_active")
  companyId         String    @map("company_id") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  version           Int       @default(1)
  changeSeq         BigInt    @default(0) @map("change_seq")
  changeXid         BigInt    @default(0) @map("change_xid")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?   @map("created_by_device_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products          Product[]

  @@unique([companyId, name])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("product_category")
}

/// Produit ; ses articles sont ses parfums (BR-CAT-12, BR-CAT-13). [S]
model Product {
  id                      String           @id @db.Uuid
  reference               String
  name                    String
  photoKey                String?          @map("photo_key")
  isActive                Boolean          @default(true) @map("is_active")
  companyId               String           @map("company_id") @db.Uuid
  rangeId                 String           @map("range_id") @db.Uuid
  categoryId              String?          @map("category_id") @db.Uuid
  deletedAt               DateTime?        @map("deleted_at") @db.Timestamptz(3)
  version                 Int              @default(1)
  changeSeq               BigInt           @default(0) @map("change_seq")
  changeXid               BigInt           @default(0) @map("change_xid")
  createdByUserId         String?          @map("created_by_user_id") @db.Uuid
  createdByDeviceId       String?          @map("created_by_device_id") @db.Uuid
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                 Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplierId              String?          @map("supplier_id") @db.Uuid
  range                   ProductRange     @relation(fields: [rangeId], references: [id])
  category                ProductCategory? @relation(fields: [categoryId], references: [id])
  productVariants         ProductVariant[]
  productUnits            ProductUnit[]
  prices                  Price[]
  priceTiers              PriceTier[]
  bonusRulesAsBuyProduct  BonusRule[]      @relation("BonusBuyProduct")
  bonusRulesAsFreeProduct BonusRule[]      @relation("BonusFreeProduct")
  orderLines              OrderLine[]
  supplier                Supplier?        @relation(fields: [supplierId], references: [id])
  incentiveRules          IncentiveRule[]

  @@unique([companyId, reference])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("product")
}

/// Article : un parfum, ou le parfum par défaut d’un produit sans parfum. [S]
model ProductVariant {
  id                      String               @id @db.Uuid
  reference               String
  name                    String
  isDefault               Boolean              @default(false) @map("is_default")
  photoKey                String?              @map("photo_key")
  isActive                Boolean              @default(true) @map("is_active")
  sortOrder               Int                  @default(0) @map("sort_order")
  /// Seuil de stock faible, en unité de base (phase 17).
  lowStockQty             Int?                 @map("low_stock_qty")
  companyId               String               @map("company_id") @db.Uuid
  productId               String               @map("product_id") @db.Uuid
  deletedAt               DateTime?            @map("deleted_at") @db.Timestamptz(3)
  version                 Int                  @default(1)
  changeSeq               BigInt               @default(0) @map("change_seq")
  changeXid               BigInt               @default(0) @map("change_xid")
  createdByUserId         String?              @map("created_by_user_id") @db.Uuid
  createdByDeviceId       String?              @map("created_by_device_id") @db.Uuid
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                 Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product                 Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices                  Price[]
  priceTiers              PriceTier[]
  bonusRulesAsBuyVariant  BonusRule[]          @relation("BonusBuyVariant")
  bonusRulesAsFreeVariant BonusRule[]          @relation("BonusFreeVariant")
  quotas                  Quota[]
  lostDemands             LostDemand[]
  orderLines              OrderLine[]
  stocks                  Stock[]
  stockMovements          StockMovement[]
  stockReceiptLines       StockReceiptLine[]
  inventoryCountLines     InventoryCountLine[]
  loadLines               LoadLine[]
  unloadLines             UnloadLine[]
  lots                    Lot[]

  @@unique([companyId, reference])
  @@unique([productId], map: "product_variant_one_default", where: raw("is_default"))
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("product_variant")
}

/// Unité de base ou conditionnement (BR-CAT-01, BR-CAT-02). [S]
model ProductUnit {
  id                   String             @id @db.Uuid
  name                 String
  baseQty              Int                @map("base_qty")
  isBase               Boolean            @default(false) @map("is_base")
  isActive             Boolean            @default(true) @map("is_active")
  companyId            String             @map("company_id") @db.Uuid
  productId            String             @map("product_id") @db.Uuid
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz(3)
  version              Int                @default(1)
  changeSeq            BigInt             @default(0) @map("change_seq")
  changeXid            BigInt             @default(0) @map("change_xid")
  createdByUserId      String?            @map("created_by_user_id") @db.Uuid
  createdByDeviceId    String?            @map("created_by_device_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices               Price[]
  priceTiers           PriceTier[]
  bonusRulesAsBuyUnit  BonusRule[]        @relation("BonusBuyUnit")
  bonusRulesAsFreeUnit BonusRule[]        @relation("BonusFreeUnit")
  quotas               Quota[]
  orderLines           OrderLine[]
  stockReceiptLines    StockReceiptLine[]

  @@unique([productId, name])
  @@unique([productId], map: "product_unit_one_base", where: raw("is_base"))
  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("product_unit")
}

/// Prix TTC ; avec un parfum, c’est son prix propre (BR-CAT-04, BR-CAT-14). [S]
model Price {
  id                String          @id @db.Uuid
  price             BigInt
  companyId         String          @map("company_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  productVariantId  String?         @map("product_variant_id") @db.Uuid
  customerTypeId    String          @map("customer_type_id") @db.Uuid
  unitId            String          @map("unit_id") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version           Int             @default(1)
  changeSeq         BigInt          @default(0) @map("change_seq")
  changeXid         BigInt          @default(0) @map("change_xid")
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?         @map("created_by_device_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  customerType      CustomerType    @relation(fields: [customerTypeId], references: [id])
  unit              ProductUnit     @relation(fields: [unitId], references: [id])

  @@unique([companyId, productId, customerTypeId, unitId], map: "price_product_unique", where: raw("product_variant_id IS NULL"))
  @@unique([companyId, productVariantId, customerTypeId, unitId], map: "price_variant_unique", where: raw("product_variant_id IS NOT NULL"))
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("price")
}

/// Palier de prix (BR-CAT-05, BR-CAT-15). [S]
model PriceTier {
  id                String          @id @db.Uuid
  minQty            Int             @map("min_qty")
  unitPrice         BigInt          @map("unit_price")
  thresholdScope    ThresholdScope  @default(ALL_VARIANTS) @map("threshold_scope")
  companyId         String          @map("company_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  productVariantId  String?         @map("product_variant_id") @db.Uuid
  customerTypeId    String          @map("customer_type_id") @db.Uuid
  unitId            String          @map("unit_id") @db.Uuid
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(3)
  version           Int             @default(1)
  changeSeq         BigInt          @default(0) @map("change_seq")
  changeXid         BigInt          @default(0) @map("change_xid")
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?         @map("created_by_device_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  customerType      CustomerType    @relation(fields: [customerTypeId], references: [id])
  unit              ProductUnit     @relation(fields: [unitId], references: [id])
  orderLines        OrderLine[]

  @@unique([companyId, productId, customerTypeId, unitId, minQty], map: "price_tier_product_unique", where: raw("product_variant_id IS NULL"))
  @@unique([companyId, productVariantId, customerTypeId, unitId, minQty], map: "price_tier_variant_unique", where: raw("product_variant_id IS NOT NULL"))
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("price_tier")
}

/// Bonus cumulatif « pour Q de X, N de Y offert » (BR-CAT-06, BR-CAT-15). [S]
model BonusRule {
  id                     String                  @id @db.Uuid
  name                   String
  buyQty                 Int                     @map("buy_qty")
  freeQty                Int                     @map("free_qty")
  freeVariantMode        FreeVariantMode         @default(AUTO_MOST_STOCK) @map("free_variant_mode")
  validFrom              DateTime                @map("valid_from") @db.Date
  validTo                DateTime?               @map("valid_to") @db.Date
  isActive               Boolean                 @default(true) @map("is_active")
  companyId              String                  @map("company_id") @db.Uuid
  buyProductId           String                  @map("buy_product_id") @db.Uuid
  buyVariantId           String?                 @map("buy_variant_id") @db.Uuid
  buyUnitId              String                  @map("buy_unit_id") @db.Uuid
  freeProductId          String                  @map("free_product_id") @db.Uuid
  freeVariantId          String?                 @map("free_variant_id") @db.Uuid
  freeUnitId             String                  @map("free_unit_id") @db.Uuid
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  version                Int                     @default(1)
  changeSeq              BigInt                  @default(0) @map("change_seq")
  changeXid              BigInt                  @default(0) @map("change_xid")
  createdByUserId        String?                 @map("created_by_user_id") @db.Uuid
  createdByDeviceId      String?                 @map("created_by_device_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  buyProduct             Product                 @relation("BonusBuyProduct", fields: [buyProductId], references: [id])
  buyVariant             ProductVariant?         @relation("BonusBuyVariant", fields: [buyVariantId], references: [id])
  buyUnit                ProductUnit             @relation("BonusBuyUnit", fields: [buyUnitId], references: [id])
  freeProduct            Product                 @relation("BonusFreeProduct", fields: [freeProductId], references: [id])
  freeVariant            ProductVariant?         @relation("BonusFreeVariant", fields: [freeVariantId], references: [id])
  freeUnit               ProductUnit             @relation("BonusFreeUnit", fields: [freeUnitId], references: [id])
  bonusRuleCustomerTypes BonusRuleCustomerType[]
  orderLines             OrderLine[]

  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("bonus_rule")
}

/// Types de clients d’un bonus ; aucun = tous.
model BonusRuleCustomerType {
  bonusRuleId    String       @map("bonus_rule_id") @db.Uuid
  customerTypeId String       @map("customer_type_id") @db.Uuid
  bonusRule      BonusRule    @relation(fields: [bonusRuleId], references: [id], onDelete: Cascade)
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)

  @@id([bonusRuleId, customerTypeId])
  @@map("bonus_rule_customer_type")
}

/// Secteur : un vendeur, des types de clients (BR-ORG-01). [S]
model Territory {
  id                     String                  @id @db.Uuid
  code                   String
  name                   String
  partCount              Int                     @default(6) @map("part_count")
  isActive               Boolean                 @default(true) @map("is_active")
  companyId              String                  @map("company_id") @db.Uuid
  sellerUserId           String?                 @map("seller_user_id") @db.Uuid
  deliveryUserId         String?                 @map("delivery_user_id") @db.Uuid
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  version                Int                     @default(1)
  changeSeq              BigInt                  @default(0) @map("change_seq")
  changeXid              BigInt                  @default(0) @map("change_xid")
  createdByUserId        String?                 @map("created_by_user_id") @db.Uuid
  createdByDeviceId      String?                 @map("created_by_device_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sellerUser             User?                   @relation("TerritorySeller", fields: [sellerUserId], references: [id])
  deliveryUser           User?                   @relation("TerritoryDelivery", fields: [deliveryUserId], references: [id])
  territoryCustomerTypes TerritoryCustomerType[]
  territoryParts         TerritoryPart[]
  partSchedules          PartSchedule[]
  customers              Customer[]

  @@unique([companyId, code])
  @@unique([companyId, sellerUserId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("territory")
}

/// Types de clients servis par un secteur (BR-ORG-03).
model TerritoryCustomerType {
  territoryId    String       @map("territory_id") @db.Uuid
  customerTypeId String       @map("customer_type_id") @db.Uuid
  territory      Territory    @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  customerType   CustomerType @relation(fields: [customerTypeId], references: [id], onDelete: Cascade)

  @@id([territoryId, customerTypeId])
  @@map("territory_customer_type")
}

/// Partie : polygone GeoJSON et boîte englobante (ARC-09). [S]
model TerritoryPart {
  id                String         @id @db.Uuid
  number            Int
  name              String
  geojson           Json
  minLat            Float          @map("min_lat")
  maxLat            Float          @map("max_lat")
  minLng            Float          @map("min_lng")
  maxLng            Float          @map("max_lng")
  companyId         String         @map("company_id") @db.Uuid
  territoryId       String         @map("territory_id") @db.Uuid
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(3)
  version           Int            @default(1)
  changeSeq         BigInt         @default(0) @map("change_seq")
  changeXid         BigInt         @default(0) @map("change_xid")
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?        @map("created_by_device_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  territory         Territory      @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  partSchedules     PartSchedule[]
  customers         Customer[]

  @@unique([territoryId, number])
  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("territory_part")
}

/// Planning : une partie par jour travaillé (BR-ORG-07). [S]
model PartSchedule {
  id                String        @id @db.Uuid
  weekday           Weekday
  companyId         String        @map("company_id") @db.Uuid
  territoryId       String        @map("territory_id") @db.Uuid
  partId            String        @map("part_id") @db.Uuid
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  version           Int           @default(1)
  changeSeq         BigInt        @default(0) @map("change_seq")
  changeXid         BigInt        @default(0) @map("change_xid")
  createdByUserId   String?       @map("created_by_user_id") @db.Uuid
  createdByDeviceId String?       @map("created_by_device_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  territory         Territory     @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  part              TerritoryPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([territoryId, weekday])
  @@index([companyId])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("part_schedule")
}

/// Client ; debt_amount est la copie à jour de la somme des écritures de dette. [S] [T]
model Customer {
  id                  String               @id @db.Uuid
  code                String?
  name                String
  phone               String?
  address             String?
  latitude            Float?
  longitude           Float?
  isPartForced        Boolean              @default(false) @map("is_part_forced")
  frequency           VisitFrequency       @default(WEEKLY)
  referenceDate       DateTime?            @map("reference_date") @db.Date
  isCreditAllowed     Boolean              @default(false) @map("is_credit_allowed")
  creditLimitAmount   BigInt               @default(0) @map("credit_limit_amount")
  debtAmount          BigInt               @default(0) @map("debt_amount")
  status              CustomerStatus       @default(ACTIVE)
  isNew               Boolean              @default(false) @map("is_new")
  isCashOnly          Boolean              @default(false) @map("is_cash_only")
  isClosedPermanently Boolean              @default(false) @map("is_closed_permanently")
  companyId           String               @map("company_id") @db.Uuid
  customerTypeId      String               @map("customer_type_id") @db.Uuid
