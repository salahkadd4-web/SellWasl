  orderLines        OrderLine[]
  deliveries        Delivery[]
  payments          Payment[]

  @@unique([companyId, number])
  @@index([companyId, deliveryDate, status])
  @@index([companyId, sellerUserId, orderDate])
  @@index([companyId, changeSeq])
  @@index([companyId, changeXid])
  @@map("order")
}

/// Ligne : normale, en attente ou bonus ; prix et règles figés (BR-CAT-09). [S] [T]
model OrderLine {
  id                String         @id @db.Uuid
  kind              OrderLineKind
