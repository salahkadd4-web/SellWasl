DATABASE_URL=postgresql://sellwasl:sellwasl@localhost:5433/sellwasl
API_PORT=3001
# Dossier des fichiers importés (en attendant le stockage S3)
STORAGE_DIR=storage
# Photos des produits sur Cloudinary (facultatif) : cloudinary://<clé>:<secret>@<cloud>
# Ne jamais la mettre dans le dépôt. Sans elle, les photos restent dans STORAGE_DIR.
# CLOUDINARY_URL=
# --- Sécurité (docs/security.md, phase 27) ---
# Secret des jetons d'accès : 32 caractères au moins, obligatoire en staging et production.
# JWT_ACCESS_SECRET=
# Clé AES-256 des données chiffrées (secrets du deuxième facteur) : 32 octets en base64,
# obligatoire en staging et production. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_ENCRYPTION_KEY=
# Nombre de proxys de confiance devant l'API (0 : X-Forwarded-For ignoré).
TRUST_PROXY=0
# Adresses ou plages autorisées à voir la plateforme (super-admin), ex. 198.51.100.4,10.0.0.0/8.
# Sans valeur : ouverte en développement, fermée en staging et production.
# PLATFORM_ALLOWED_IPS=
# Erreurs envoyées à Sentry (facultatif).
# SENTRY_DSN=
