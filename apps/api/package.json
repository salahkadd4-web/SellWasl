{
  "name": "@sellwasl/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm prisma:generate && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p prisma/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev && prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:reset": "prisma migrate reset --force && prisma generate && prisma db seed",
    "test": "prisma generate && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@sellwasl/business-rules": "workspace:*",
    "@sellwasl/validation": "workspace:*",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.33.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.2.7",
    "@sellwasl/config": "workspace:*",
    "@sellwasl/offline": "workspace:*",
    "@swc/core": "^1.16.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-dist": "^3.30.6",
    "dotenv": "^17.2.2",
    "pino-pretty": "^13.1.1",
    "prisma": "~7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
