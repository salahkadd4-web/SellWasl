{
  "name": "sellwasl",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@sellwasl/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sellwasl/api prisma:migrate",
    "db:generate": "pnpm --filter @sellwasl/api prisma:generate",
    "dev:mobile": "pnpm --filter @sellwasl/mobile dev",
    "db:seed": "pnpm build:packages && pnpm --filter @sellwasl/api prisma:seed",
    "db:reset": "pnpm build:packages && pnpm --filter @sellwasl/api prisma:reset",
    "db:studio": "pnpm --filter @sellwasl/api prisma:studio",
    "build:packages": "turbo run build --filter=./packages/*",
    "postinstall": "pnpm build:packages"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
