# Copier en .env à la racine de apps/api et apps/web, puis adapter.

# --- API ---
DATABASE_URL=postgresql://sellwasl:sellwasl@localhost:5433/sellwasl
API_PORT=3001
JWT_ACCESS_SECRET=changer-moi
# Les jetons de rafraîchissement sont aléatoires et hachés en base : pas de secret à fournir.

# --- Web ---
API_URL=http://localhost:3001
# Espace plateforme (/admin) : mêmes valeurs que l'API ; TRUST_PROXY compte les proxys devant Next.js
# PLATFORM_ALLOWED_IPS=
# TRUST_PROXY=1
# Sentry (facultatif) : serveur Next.js et navigateur
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# --- Mobile ---
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
