  "devDependencies": {
    "@sellwasl/config": "workspace:*",
    "@sellwasl/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "vitest": "^5.0.3"
  }
}
