{
  "name": "@sellwasl/offline",
  "version": "0.0.0",
  "private": true,
  "description": "Moteur hors connexion du téléphone : file d'envoi, synchronisation, vues locales (phase 23).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@sellwasl/business-rules": "workspace:*",
    "@sellwasl/validation": "workspace:*"
  },
  "devDependencies": {
    "@sellwasl/config": "workspace:*",
    "@sellwasl/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "vitest": "^5.0.3"
  }
}
